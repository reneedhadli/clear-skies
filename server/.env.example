# Easiest: a Gemini key (https://aistudio.google.com/apikey). If set, it is used first.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash

# Anthropic API key. With 1Password, use an op:// reference instead.
AI_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-sonnet-4-5
PORT=3001

# Optional: uncomment when using 1Password CLI (npm run dev:secure)
# AI_API_KEY=op://Private/Anthropic/credential
